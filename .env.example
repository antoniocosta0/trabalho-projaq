# Copie para .env e ajuste, se precisar. O compose.yaml ja tem estes valores
# como padrao, entao o .env e opcional.

# Porta publicada no host (somente 127.0.0.1).
PLANOS_PORT=8080

# Tag da imagem construida.
PLANOS_TAG=p2-etapa0

# Relogio da aplicacao. Vazio = relogio real.
# Exemplo para ensaiar a apresentacao: 2026-10-19T10:00:00
APP_RELOGIO_ZONA=America/Sao_Paulo
APP_RELOGIO_INSTANTE_FIXO=
