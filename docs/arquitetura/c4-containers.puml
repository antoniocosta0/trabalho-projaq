@startuml
' C4 nível 2 - Containers
' PUCRS - Projeto e Arquitetura de Software - 2026/2 - turma 340
!include <C4/C4_Container>

title
  Nível 2 - Containers
  <size:11>Exportado em 2026-10-15</size>
end title

Person(usuario, "Usuário", "Monta, valida, aprova e gerencia planos de voo")
System_Ext(cliente, "Cliente HTTP", "Postman, arquivo .http ou Swagger UI")

System_Boundary(sistema, "Sistema de Gestão de Planos de Voo") {
  Container(api, "Backend", "Java 25, Spring Boot 4.1.1", "Expõe a API REST, aplica as regras de negócio dos planos de voo e controla a ocupação de aerovias e vagas")
  ContainerDb(banco, "Banco de dados", "H2 2.4.240, modo arquivo (./data/planosdevoo)", "Guarda rede aérea, pilotos, aeronaves, planos, trechos e reservas. O estado sobrevive à reinicialização da aplicação")
}

Rel(usuario, cliente, "Usa")
Rel(cliente, api, "Envia requisições", "HTTP/JSON")
Rel(api, banco, "Lê e grava dados", "JPA/Hibernate sobre JDBC")

note right of banco
  Schema criado por src/main/resources/db/schema.sql
  e carga inicial aplicada por db/data.sql, na
  inicialização. Reprodutível a partir do repositório.
end note

@enduml
