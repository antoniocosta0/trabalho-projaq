@startuml
!include <C4/C4_Component>

title Nível 3 - Componentes do Backend (hexagonal)

System_Ext(cliente, "Cliente HTTP", "curl, Swagger UI, REST Client")
ContainerDb(banco, "Banco da gestão", "H2 em arquivo", "Frota, planos, reservas e outbox")
Container_Ext(cadastro, "Cadastro da rede aérea", "Spring Boot", "Aeroportos, vagas e aerovias")

Container_Boundary(api, "Gestão de planos (Spring Boot)") {
  Component(rest, "Adaptadores REST", "Spring Web MVC", "FrotaController, DisponibilidadeController, PlanoDeVooController, DTOs e RestExceptionHandler")
  Component(portas_in, "Portas de entrada", "Interfaces Java", "FrotaUseCase, DisponibilidadeUseCase, PlanoDeVooUseCase e os commands")
  Component(servicos, "Serviços", "Java puro", "FrotaService, DisponibilidadeService, PlanoDeVooService")
  Component(modelo, "Modelo de domínio", "Java puro", "PlanoDeVoo, Trecho, Pouso, Slot, Aerovia, Aeroporto, Aeronave e categorias, reservas")
  Component(portas_out, "Portas de saída", "Interfaces Java", "MalhaAereaPort, AprovacaoPublisherPort, PilotoRepository, AeronaveRepository, PlanoDeVooRepository, ReservaRepository, TransacaoPort")
  Component(persistencia, "Adaptadores de persistência", "Spring Data JPA", "RepositoryAdapters, AprovacaoOutboxAdapter (tabela outbox_evento), JpaRepositories, entidades JPA, mappers e TransacaoSpringAdapter")
  Component(http, "Adaptador HTTP do cadastro", "RestClient + Spring Cloud LoadBalancer", "MalhaAereaHttpAdapter: 404 vira vazio, demais falhas viram 503; tempos limite 2 s / 3 s")
  Component(config, "Configuração", "Spring @Configuration", "ServiceConfig cria os serviços; OpenApiConfig")
}

Rel(cliente, rest, "Requisições", "HTTP/JSON")
Rel(rest, portas_in, "Chama")
Rel_U(servicos, portas_in, "Implementa")
Rel(servicos, modelo, "Usa")
Rel(servicos, portas_out, "Usa")
Rel_U(persistencia, portas_out, "Implementa")
Rel(persistencia, banco, "Lê e grava", "JDBC")
Rel_U(http, portas_out, "Implementa")
Rel(http, cadastro, "GET /aeroportos/{codigo}/vagas, GET /aerovias/{id}", "HTTP/JSON")
Rel(config, servicos, "Instancia")

@enduml
