@startuml
!include <C4/C4_Component>

title Nível 3 - Componentes do Backend (hexagonal)

System_Ext(cliente, "Cliente HTTP", "curl, Swagger UI, REST Client")
ContainerDb(banco, "Banco de dados", "H2 em arquivo", "Malha aérea, frota, planos e reservas")

Container_Boundary(api, "Backend (Spring Boot)") {
  Component(rest, "Adaptadores REST", "Spring Web MVC", "MalhaAereaController, FrotaController, DisponibilidadeController, PlanoDeVooController, DTOs e RestExceptionHandler")
  Component(portas_in, "Portas de entrada", "Interfaces Java", "MalhaAereaUseCase, FrotaUseCase, DisponibilidadeUseCase, PlanoDeVooUseCase e os commands")
  Component(servicos, "Serviços", "Java puro", "MalhaAereaService, FrotaService, DisponibilidadeService, PlanoDeVooService")
  Component(modelo, "Modelo de domínio", "Java puro", "PlanoDeVoo, Trecho, Pouso, Slot, Aerovia, Aeroporto, Aeronave e categorias, reservas")
  Component(portas_out, "Portas de saída", "Interfaces Java", "MalhaAereaPort, AprovacaoPublisherPort, AeroportoRepository, AeroviaRepository, PilotoRepository, AeronaveRepository, PlanoDeVooRepository, ReservaRepository, TransacaoPort")
  Component(persistencia, "Adaptadores de persistência", "Spring Data JPA", "RepositoryAdapters, MalhaAereaLocalAdapter, AprovacaoOutboxAdapter (tabela outbox_evento), JpaRepositories, entidades JPA, mappers e TransacaoSpringAdapter")
  Component(config, "Configuração", "Spring @Configuration", "ServiceConfig cria os serviços; OpenApiConfig")
}

Rel(cliente, rest, "Requisições", "HTTP/JSON")
Rel(rest, portas_in, "Chama")
Rel_U(servicos, portas_in, "Implementa")
Rel(servicos, modelo, "Usa")
Rel(servicos, portas_out, "Usa")
Rel_U(persistencia, portas_out, "Implementa")
Rel(persistencia, banco, "Lê e grava", "JDBC")
Rel(config, servicos, "Instancia")

@enduml
