@startuml
title Modelo de Domínio - Planos de Voo
hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam shadowing false

class Aeroporto {
  codigo
  nome
  quantidadeVagas
  --
  possuiVaga(numero) : boolean
}

class Aerovia {
  id
  origem (código)
  destino (código)
  distanciaKm
  --
  duracao(velocidade) : Duration
}

note right of Aerovia
  Orientada e imutável. O trecho guarda uma
  cópia; o cadastro mestre fica na malha.
end note

class Piloto {
  id
  nome
}

abstract class Aeronave <<sealed>> {
  prefixo
  velocidadeCruzeiroKmh
  autonomiaKm
  --
  distanciaMaxSemAbastecer() : double
  {abstract} podeOperar(altitude, entrada, saida) : boolean
}

class AeronaveParticular {
  empresaManutencao
}

class AeronavePassageiros {
  companhiaAerea
  capacidadePassageiros
}

class AeronaveCarga {
  companhiaAerea
  capacidadeToneladas
}

class AeronaveFactory {
  {static} criar(categoria, ...) : Aeronave
}

class PlanoDeVoo <<raiz de agregado>> {
  id
  criador
  origem (código)
  destino (código)
  partida
  situacao
  --
  pertenceA(usuario) : boolean
  alterarDados(piloto, aeronave, origem, destino, partida)
  adicionarTrecho(aerovia, altitude, entrada, pouso)
  alterarTrecho(ordem, ...)
  removerTrecho(ordem)
  validar() : List<String>
  aprovar(problemasDosRecursos)
  cancelar(agora)
  abandonar()
  reservasDeAerovia() : List<ReservaAerovia>
  reservasDeVaga() : List<ReservaVaga>
}

class Trecho {
  ordem
  altitude
  horarioEntrada
  --
  horarioChegada() : LocalDateTime
  slotsOcupados() : List<Slot>
  slotsDaVaga() : List<Slot>
  reservasDeAerovia(planoId)
  reservasDeVaga(planoId)
}

class Pouso <<value object>> {
  numeroVaga
  permanenciaMinutos
  --
  saida(chegada) : LocalDateTime
}

class Slot <<value object>> {
  inicio
  --
  {static} entre(inicio, fim) : List<Slot>
}

note bottom of Slot
  1 hora alinhada à hora cheia, intervalo [inicio, fim).
  15:52 -> 17:07 ocupa 3 slots.
end note

class ReservaAerovia {
  planoId
  aeroviaId
  altitude
}

class ReservaVaga {
  planoId
  aeroportoCodigo
  numeroVaga
}

enum SituacaoPlano {
  EM_EDICAO
  APROVADO
  CANCELADO
  ABANDONADO
}

Aerovia "*" ..> "1" Aeroporto : origem
Aerovia "*" ..> "1" Aeroporto : destino

Aeronave <|-- AeronaveParticular
Aeronave <|-- AeronavePassageiros
Aeronave <|-- AeronaveCarga
AeronaveFactory ..> Aeronave : cria

PlanoDeVoo "*" --> "1" Piloto
PlanoDeVoo "*" --> "1" Aeronave
PlanoDeVoo "*" ..> "1" Aeroporto : origem
PlanoDeVoo "*" ..> "1" Aeroporto : destino
PlanoDeVoo --> SituacaoPlano
PlanoDeVoo "1" *-- "0..*" Trecho : percurso
Trecho "*" --> "1" Aerovia
Trecho "1" *-- "0..1" Pouso

PlanoDeVoo "1" -- "0..*" ReservaAerovia
PlanoDeVoo "1" -- "0..*" ReservaVaga
ReservaAerovia "*" ..> "1" Aerovia
ReservaAerovia "*" --> "1" Slot
ReservaVaga "*" ..> "1" Aeroporto
ReservaVaga "*" --> "1" Slot

note as referencias
  Setas tracejadas: referência por código,
  sem chave estrangeira (etapa 1 da parte 2).
end note

@enduml
