@startuml
' Modelo de domínio - Sistema de Gestão de Planos de Voo
' PUCRS - Projeto e Arquitetura de Software - 2026/2 - turma 340
' Entrega de 05/10. Fonte versionada; o .png é exportado deste arquivo.

title
  Modelo de Domínio - Planos de Voo
  <size:11>Exportado em 2026-10-18</size>
end title
hide circle
hide empty members
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 70
skinparam ranksep 70

class Aeroporto {
  codigo
  nome
  quantidadeVagas
  --
  possuiVaga(numero) : boolean
}

class Aerovia {
  id
  distanciaKm
  --
  duracao(velocidadeCruzeiro) : Duration
}

note right of Aerovia
  Imutável após o cadastro: não há
  alteração nem exclusão.
  Orientada: POA->FLN (R1) e
  FLN->POA (R8) são aerovias distintas.
end note

class Piloto {
  id
  nome
}

abstract class Aeronave {
  prefixo
  velocidadeCruzeiro
  autonomia
  --
  distanciaMaxSemAbastecer() : double
  {abstract} podeOperar(altitude, entrada, saida) : boolean
  {abstract} dados() : DadosAeronave
}

class FabricaDeAeronaves <<fábrica>> {
  {static} criar(dados) : Aeronave
}

note left of Aeronave
  podeOperar() é polimórfico: cada
  categoria traz a sua regra de altitude
  e de janela de horário. Categoria nova
  entra como subclasse nova, sem alterar
  a validação do plano.
  dados() faz o caminho inverso: cada
  categoria responde pelos próprios
  campos de cadastro.
end note

note right of FabricaDeAeronaves
  Único ponto que conhece as subclasses.
  Usada no cadastro (POST /aeronaves) e
  ao ler do banco. Categoria nova = um
  case novo aqui. Ver ADR 0006.
end note

FabricaDeAeronaves ..> Aeronave : cria

class AeronaveParticular {
  empresaManutencao
}

class AeronavePassageiros {
  companhiaAerea
  capacidadePassageiros
}

class AeronaveCarga {
  companhiaAerea
  capacidadeToneladas
}

class PlanoDeVoo <<raiz de agregado>> {
  id
  partida
  situacao
  --
  adicionarTrecho(aerovia, altitude, entrada, pouso)
  alterarTrecho(ordem, aerovia, altitude, entrada, pouso)
  removerTrecho(ordem)
  validar() : List<String>
  aprovar(conflitosDeReserva, agora)
  abandonar()
  cancelar(agora)
  reservasDeAerovia() : List<ReservaAerovia>
  reservasDeVaga() : List<ReservaVaga>
}

note top of PlanoDeVoo
  Raiz do agregado: Trecho e Pouso só
  existem dentro do plano e toda alteração
  passa por ele. validar() devolve a lista
  de problemas (não boolean, não exceção)
  e não altera estado nem reserva nada.
end note

class Trecho {
  ordem
  altitude
  horarioEntrada
  --
  horarioChegada() : LocalDateTime
  slotsOcupados() : List<Slot>
  slotsDaVaga() : List<Slot>
  {static} altitudesPermitidas() : List<Integer>
}

class Pouso <<value object>> {
  numeroVaga
  permanenciaMinutos
  --
  saida(chegada) : LocalDateTime
}

class Slot <<value object>> {
  inicio
  --
  {static} entre(inicio, fim) : List<Slot>
}

note bottom of Slot
  Slot de 1 hora alinhado à hora cheia.
  Qualquer uso parcial ocupa o slot inteiro:
  15:52 -> 17:07 são 3 slots.
  Intervalo [inicio, fim): 15:00 -> 16:00
  ocupa 1 slot.
end note

class ReservaAerovia {
  planoId
  altitude
}

class ReservaVaga {
  planoId
  numeroVaga
}

class VerificadorDeConflitos <<serviço de domínio>> {
  verificar(plano) : List<String>
}

note bottom of VerificadorDeConflitos
  Consulta as reservas dos outros planos
  (porta de saída) e devolve os conflitos de
  altitude e de vaga. Só consulta: nunca reserva.
end note

enum SituacaoPlano {
  EM_EDICAO
  APROVADO
  CANCELADO
  ABANDONADO
}

Aerovia "*" --> "1" Aeroporto : origem >
Aerovia "*" --> "1" Aeroporto : destino >

Aeronave <|-- AeronaveParticular
Aeronave <|-- AeronavePassageiros
Aeronave <|-- AeronaveCarga

PlanoDeVoo "*" --> "1" Piloto
PlanoDeVoo "*" --> "1" Aeronave
PlanoDeVoo "*" --> "1" Aeroporto : origem >
PlanoDeVoo "*" --> "1" Aeroporto : destino >
PlanoDeVoo --> SituacaoPlano
PlanoDeVoo "1" *-- "0..*" Trecho : percurso
Trecho "*" --> "1" Aerovia
Trecho "1" *-- "0..1" Pouso

PlanoDeVoo "1" -- "0..*" ReservaAerovia
PlanoDeVoo "1" -- "0..*" ReservaVaga
ReservaAerovia "*" --> "1" Aerovia
ReservaAerovia "*" --> "1" Slot
ReservaVaga "*" --> "1" Aeroporto
ReservaVaga "*" --> "1" Slot
VerificadorDeConflitos ..> PlanoDeVoo : confere

@enduml
